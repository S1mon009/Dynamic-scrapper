{
  "name": "dynamic-scraper",
  "version": "1.0.0",
  "description": "Production-grade CLI for scraping static and JavaScript-rendered websites, with composable filters, hierarchical (tree) task configuration and pluggable scraper strategies.",
  "type": "module",
  "license": "MIT",
  "author": "S1mon009",
  "bin": {
    "scraper": "./bin/scraper.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "docs": "typedoc",
    "prepare": "husky",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "release": "semantic-release",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.1",
    "mime-types": "^2.1.35",
    "p-limit": "^6.1.0",
    "playwright": "^1.47.2",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.11.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "semantic-release": "^25.0.8",
    "tsx": "^4.19.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yaml,yml,json}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "cli",
    "scraper",
    "web-scraping",
    "playwright",
    "typescript"
  ]
}
